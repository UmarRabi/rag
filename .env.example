RAG_ENVIRONMENT=local
RAG_LOG_LEVEL=INFO
RAG_DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5434/rag
RAG_DATABASE_POOL_SIZE=10
RAG_DATABASE_MAX_OVERFLOW=20
RAG_MODEL_CACHE_DIR=models
RAG_PRELOAD_MODELS=false
HF_HUB_DISABLE_SYMLINKS_WARNING=1

RAG_STORAGE_BACKEND=local
RAG_STORAGE_LOCAL_ROOT=storage
RAG_STORAGE_BUCKET=rag-platform
RAG_STORAGE_REGION=us-east-1
RAG_STORAGE_ENDPOINT_URL=http://localhost:9000
RAG_STORAGE_ACCESS_KEY_ID=rag
RAG_STORAGE_SECRET_ACCESS_KEY=rag-secret-key
RAG_STORAGE_ENCRYPTION_KEY=

RAG_WORKER_CONCURRENCY=2
RAG_WORKER_IDLE_SECONDS=1
RAG_WORKER_STALE_AFTER_SECONDS=900
RAG_JOB_RETRY_BASE_SECONDS=10

RAG_API_KEY_PEPPER=
RAG_PLATFORM_ADMIN_KEY=
RAG_REDIS_URL=redis://localhost:6379/5
RAG_RATE_LIMIT_SEARCH=60
RAG_RATE_LIMIT_INGEST=30
RAG_RATE_LIMIT_API=120
